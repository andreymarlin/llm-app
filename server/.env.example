# ============================================================
# Realtor AI Assistant — server configuration (Windows)
# Copy this file to `server\.env` and adjust the values.
# `setup.ps1` creates `server\.env` for you automatically.
# ============================================================

# OpenAI-compatible endpoint of your local LLM server.
#   llama.cpp `llama-server.exe` -> http://127.0.0.1:8080/v1
#   LM Studio                  -> http://127.0.0.1:1234/v1
#   Ollama                     -> http://127.0.0.1:11434/v1
LLM_BASE_URL=http://127.0.0.1:8080/v1

# API key. Leave empty for local servers (llama.cpp / LM Studio / Ollama).
LLM_API_KEY=

# How long (seconds) to wait for a model reply. Long on CPU-only machines.
LLM_TIMEOUT=600

# Default models for the two agents. Use the exact model id shown by your
# LLM server (e.g. `qwen2.5-7b-instruct` in llama.cpp, or `qwen/qwen2.5-7b-instruct`
# in LM Studio, or `qwen2.5:7b-instruct` in Ollama).
REALTOR_MODEL=qwen2.5-7b-instruct
ANALYST_MODEL=qwen2.5-7b-instruct

# Where the SQLite database lives. Chat history and prompts are stored here.
STATE_DIR=C:\Users\YOUR_USERNAME\realtor-ai-app\state

# Optional: absolute path to a local GGUF model file. If set, run.ps1 can
# start `llama-server.exe` for you automatically when the LLM is unreachable.
LOCAL_GGUF_PATH=C:\Users\YOUR_USERNAME\realtor-ai-app\models\Qwen2.5-7B-Instruct-Q4_K_M.gguf

# Optional: path to the llama-server.exe binary (used by run.ps1 auto-start).
LLAMA_SERVER_PATH=C:\Users\YOUR_USERNAME\realtor-ai-app\bin\llama-server.exe

# Optional: host/port for the web UI.
HOST=127.0.0.1
PORT=8000